# REST

## Variables
@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}
@user_username = {{$dotenv USER_USERNAME}}
@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}

## 1.Admin
### 1.1 Login
POST http://localhost:9192/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}

### 1.2 Register (admin) one time for first time to create admin account
POST http://localhost:9192/admin/register-admin
Content-Type: application/json

{
    "firstname": "Admin",
    "lastname": "User",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}

### 1.3 Forgot Password
POST http://localhost:9192/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}

### 1.3.1 Reset Password
POST http://localhost:9192/admin/reset-password
Content-Type: application/json

{
    "code": "paste_admin_reset_token_here",
    "password": "{{admin_password}}",
    "passwordConfirmation": "{{admin_password}}"
}

### 1.4 Profile
GET http://localhost:9192/admin/users/me
Authorization: Bearer <admin-jwt-token>

## 2.User
### 2.1 Login
POST http://localhost:9192/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.2 Register
POST http://localhost:9192/api/auth/local/register
Content-Type: application/json

{
    "username": "{{user_username}}",
    "email": "{{user_email}}",
    "password": "{{user_password}}"
}

### 2.3 Forgot Password
POST http://localhost:9192/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}

### 2.3.1 Reset Password
POST http://localhost:9192/api/auth/reset-password
Content-Type: application/json

{
    "code": "paste_user_reset_token_here",
    "password": "{{user_password}}",
    "passwordConfirmation": "{{user_password}}"
}

### 2.4 Profile
GET http://localhost:9192/api/users/me
Authorization: Bearer <user-jwt-token>